# Copy this file to .env and fill it in. .env is private and is never committed.

# Prowlarr -> Settings -> General -> API Key
PROWLARR_API_KEY=

# A long random secret that signs login sessions.  Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Free key from https://www.themoviedb.org (Settings -> API). Needed for posters, trailers, descriptions.
TMDB_API_KEY=

# Port the web app is published on
HTTP_PORT=3111

# Where Prowlarr and TorrServer keep their settings. Default: inside this folder (./data/...).
# If they already run from another folder, put the ABSOLUTE paths here so nothing is lost:
# PROWLARR_CONFIG_DIR=/home/you/movies/data/prowlarr
# TORRSERVER_CONFIG_DIR=/home/you/movies/data/torrserver
